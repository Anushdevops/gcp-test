# Example values for terraform.tfvars
# Copy this file to terraform.tfvars and update the values

project_id    = "your-gcp-project-id"
region        = "us-central1"
zone          = "us-central1-a"
prefix        = "jenkins"
machine_type  = "e2-medium"
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... (your actual SSH public key content)"
# public_key_path is deprecated - use ssh_public_key instead
# public_key_path = "~/.ssh/id_rsa.pub"