# Example values for terraform.tfvars
# Copy this file to terraform.tfvars and update the values
#
# IMPORTANT: Avoid hidden characters like tabs or extra spaces:
# - Type values manually OR use heredoc: cat > terraform.tfvars << 'EOF' ... EOF
# - No extra whitespace around =
# - Use straight double quotes: "value"
# - No trailing spaces after values
#
# EXAMPLE VALUES (replace with your actual values):
# - project_id: Your GCP project ID or number (e.g., "my-project-123" or "123456789012")
# - region: Any valid GCP region (e.g., "us-central1", "europe-west1", "asia-east1")
# - zone: A zone within your chosen region (e.g., "us-central1-a", "europe-west1-b")
# - ssh_public_key: FULL content of your ~/.ssh/id_rsa.pub file (starts with ssh-rsa)
# - prefix: Optional resource name prefix (default: "jenkins")
# - machine_type: VM machine type (default: "e2-medium")

project_id   = "your-gcp-project-id-or-number"
region       = "us-central1"
zone         = "us-central1-a"
prefix       = "jenkins"
machine_type = "e2-medium"
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC... (COPY THE FULL OUTPUT OF: cat ~/.ssh/id_rsa.pub)"
# public_key_path is deprecated - use ssh_public_key instead
# public_key_path = "~/.ssh/id_rsa.pub"